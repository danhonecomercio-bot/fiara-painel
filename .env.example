# URL do projeto. Ex.: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon). Em projetos novos a Supabase chama isso de publishable key.
# Cole o valor aqui mesmo assim. Ela pode ir para o browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo do servidor. Não use o prefixo NEXT_PUBLIC_ e não commite o valor real.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que os bots enviam em Authorization: Bearer ...
BOT_API_KEY=

# Dissecador: baixar_top_ads e dissecar. Se faltar o par novo, o servidor usa TOPADS_*.
# Também cobre a varredura em idiomas quando o par do Minerador não existe.
DISSECADOR_WEBHOOK_URL=
DISSECADOR_WEBHOOK_KEY=
TOPADS_WEBHOOK_URL=
TOPADS_WEBHOOK_KEY=

# Minerador: botão e auto "varredura_idiomas". Se esse par faltar, vale o par do Dissecador.
MINERADOR_WEBHOOK_URL=
MINERADOR_WEBHOOK_KEY=

# Webhook do agente de modelagem. Sem as duas, o botão fica "em breve".
MODELADOR_WEBHOOK_URL=
MODELADOR_WEBHOOK_KEY=

# Só para abrir o painel neste computador sem Supabase.
# Na Vercel isso precisa ficar desligado. Se a URL do Supabase existir, o modo demo é ignorado.
# DEMO_MODE=true
